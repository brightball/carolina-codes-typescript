{
  "name": "carolina-codes-typescript",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "sast": "eslint --max-warnings 0 src test perf_test.ts",
    "audit": "npm audit --audit-level=moderate",
    "style": "prettier --check .",
    "format": "prettier --write .",
    "hooks": "pre-commit install && git config core.hooksPath .githooks"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^3.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0"
  }
}
